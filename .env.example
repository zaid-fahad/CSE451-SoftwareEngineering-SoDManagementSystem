# ==============================================================================
# Departmental SoD Management System - Production Environment Configuration
# ==============================================================================
# Copy this file to .env when running locally with docker compose,
# or set these variables in the Coolify project dashboard.
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=sod_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_secure_postgres_password_here

# JWT Authentication
# Run in terminal to generate a secure key: openssl rand -hex 32
JWT_SECRET=generate_a_random_32_byte_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Host & Port Exposure
BACKEND_PORT=8000
WEB_CONCURRENCY=2

# CORS Configuration
# Provide comma-separated list of allowed frontend origins (e.g. Cloudflare Pages production & custom domains)
CORS_ORIGINS=https://your-sod-app.pages.dev,https://sod.youruniversity.edu,http://localhost:3000
# Automatically allow preview deployments from Cloudflare (*.pages.dev)
CORS_ALLOW_CLOUDFLARE_PAGES=true

# Initial Admin / Department Manager Bootstrap (Idempotent)
# This account is created automatically if it doesn't already exist in the database
FIRST_ADMIN_EMAIL=admin@univ.edu
FIRST_ADMIN_PASSWORD=SetAStrongInitialAdminPassword123!
FIRST_ADMIN_NAME=Department Administrator
FIRST_ADMIN_DEPT_ID=ADMIN-0001
FIRST_ADMIN_ROLE=DeptManager

# Demo Seeding (Optional)
# Set to true ONLY if you want to populate demo students, schedules, and duties on startup
RUN_DEMO_SEED=false
